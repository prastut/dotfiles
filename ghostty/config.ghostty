# Ghostty config. Installed as a symlink by install.sh.
# Reload after editing: cmd+shift+,

# --- Readability (keratoconus-friendly) ---
# Light mode: dark-on-light removed the halos. Catppuccin Latte is a cool
# grey-white with softer text (#4c4f69) than Gruvbox, and herdr has a matching theme.
theme = Catppuccin Latte

# Warm alternative (felt like a desert):
# theme = Gruvbox Light
# background = #f2e5bc

# Dark mode, to switch back: comment out the theme line above, uncomment below.
# theme = Gruvbox Dark
# foreground = #d5c4a1
# background = #32302f

# Designed for low vision: similar letters (l 1 I, 0 O) are clearly distinct.
# Install: brew install --cask font-atkinson-hyperlegible-mono
font-family = Atkinson Hyperlegible Mono

# Bigger text, more space between lines.
font-size = 15
adjust-cell-height = 20%
# Off: thicker strokes gave off more light and made halos worse.
font-thicken = false

# --- herdr shortcuts (iTerm-style) ---
# herdr's prefix is ctrl+b, which is the byte \x02.
# Each Cmd key sends the prefix plus a herdr key, so herdr handles the split/tab
# instead of Ghostty making its own.

# cmd+d: split side by side (new pane on the right)
keybind = super+d=text:\x02v
# cmd+shift+d: split top and bottom
keybind = super+shift+d=text:\x02-
# cmd+t: new herdr tab
keybind = super+t=text:\x02c
# cmd+w: close the herdr pane. WARNING: kills whatever runs in it, agents included.
keybind = super+w=text:\x02x
# cmd+b: toggle herdr sidebar (collapse/expand)
keybind = super+b=text:\x02b

# cmd+1..9: jump to herdr tab 1-9. Ghostty binds both the character and the
# physical key (digit_N), so both are overridden.
keybind = super+1=text:\x021
keybind = super+digit_1=text:\x021
keybind = super+2=text:\x022
keybind = super+digit_2=text:\x022
keybind = super+3=text:\x023
keybind = super+digit_3=text:\x023
keybind = super+4=text:\x024
keybind = super+digit_4=text:\x024
keybind = super+5=text:\x025
keybind = super+digit_5=text:\x025
keybind = super+6=text:\x026
keybind = super+digit_6=text:\x026
keybind = super+7=text:\x027
keybind = super+digit_7=text:\x027
keybind = super+8=text:\x028
keybind = super+digit_8=text:\x028
keybind = super+9=text:\x029
keybind = super+digit_9=text:\x029
# cmd+shift+[ / cmd+shift+]: previous / next herdr tab
keybind = super+shift+[=text:\x02p
keybind = super+shift+]=text:\x02n

# cmd+s: send ctrl+s (save in micro). Needs `setopt noflowcontrol` in zsh.
keybind = super+s=text:\x13

# Deliberately not mapped:
# cmd+z stays Ghostty undo. Mapping it to ctrl+z would suspend Claude Code/Codex.
# cmd+c / cmd+v stay Ghostty copy and paste.
